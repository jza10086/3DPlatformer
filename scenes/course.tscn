[sub_resource type="Shader" id="Shader_joy2u"]
code = "shader_type spatial; render_mode unshaded; varying vec3 wp; void vertex(){wp=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;} void fragment(){ float v=sin(wp.x*.13+wp.z*.11+TIME*.3)*.5+.5; float r=smoothstep(.95,1.0,sin(wp.x*.31+wp.z*.24+sin(wp.z*.2)+TIME*.25)); ALBEDO=mix(vec3(.20,.48,.56),vec3(.25,.56,.61),v)+r*.035; }"

